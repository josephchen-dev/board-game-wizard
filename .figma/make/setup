#!/bin/bash
set -e

# System dependencies for this Vite + React (pnpm) project.
# Cached after the first run, so only install what's missing.

echo "Checking system dependencies..."

# Node (project requires >=20; see .nvmrc / package.json engines)
NODE_VERSION="$(node --version 2>/dev/null || echo "none")"
if [[ "$NODE_VERSION" == "none" ]]; then
  echo "Installing node"
  brew install node
fi
echo "Node ${NODE_VERSION} OK"

# pnpm (this repo uses pnpm-lock.yaml / pnpm-workspace.yaml)
PNPM_VERSION="$(pnpm --version 2>/dev/null || echo "none")"
if [[ "$PNPM_VERSION" == "none" ]]; then
  echo "Installing pnpm"
  # Prefer corepack (ships with Node) and fall back to Homebrew.
  if command -v corepack >/dev/null 2>&1; then
    corepack enable
    corepack prepare pnpm@latest --activate
  else
    brew install pnpm
  fi
fi
echo "pnpm $(pnpm --version 2>/dev/null) OK"

echo "System dependencies verified."
